# Copy to .env.local if you need to override defaults.

# Base URL of the API as seen by the browser.
# Default "/api/v1" works in dev thanks to the Vite proxy (vite.config.ts).
# VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api and /uploads (the Express server).
# VITE_API_PROXY_TARGET=http://localhost:4000
